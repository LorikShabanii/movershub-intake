# Copy to .env (git-ignored) or set in your shell. Never commit a real key.
# Default provider is Groq (free plan, no card: console.groq.com). Mistral and Anthropic work the same way.
GROQ_API_KEY=...
# MISTRAL_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides
# INTAKE_PROVIDER=groq               # groq | mistral | anthropic | mock
# INTAKE_MODEL=openai/gpt-oss-20b    # Groq model with strict JSON-schema support
# OPENAI_COMPAT_BASE_URL=...         # point the groq provider at any OpenAI-compatible endpoint
# INTAKE_MIN_INTERVAL_S=1.1          # spacing between model calls (free-tier friendly)
# USD per million tokens on a paid plan
# INTAKE_PRICE_IN=0.10
# INTAKE_PRICE_OUT=0.50
